_G.SeekChasePathESP = _G.SeekChasePathESP or false

local function applySeekPathESP(obj)
    if not _G.SeekChasePathESP or not obj or not obj.Parent then return end
    pcall(function()
        if (obj:IsA("BasePart") or obj:IsA("Model")) and not obj:FindFirstChild("DarkNessSeekPathHighlight") then
            local n = string.lower(obj.Name)
            if n:find("path") or n:find("guide") or n:find("route") or n:find("chase") or n:find("trigger") or n:find("next") then
                local h = Instance.new("Highlight")
                h.Name = "DarkNessSeekPathHighlight"
                h.Adornee = obj
                h.FillColor = Color3.fromRGB(0, 255, 100)
                h.FillTransparency = 0.3
                h.OutlineColor = Color3.fromRGB(255, 255, 255)
                h.OutlineTransparency = 0
                h.Parent = obj
            end
        end
    end)
end

task.spawn(function()
    while true do
        task.wait(0.2)
        if _G.SeekChasePathESP then
            pcall(function()
                local cr = Workspace:FindFirstChild("CurrentRooms")
                if cr then for _, v in ipairs(cr:GetDescendants()) do applySeekPathESP(v) end end
            end)
        end
    end
end)

