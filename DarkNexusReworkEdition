-- Bildirim Sistemi
local function SendNotification(title, text)
    task.spawn(function()
        local NotifHolder = ScreenGui:FindFirstChild("NotifHolder")
        if not NotifHolder then
            NotifHolder = Instance.new("Frame")
            NotifHolder.Name = "NotifHolder"
            NotifHolder.Parent = ScreenGui
            NotifHolder.BackgroundTransparency = 1
            NotifHolder.Position = UDim2.new(1, -280, 1, -150)
            NotifHolder.Size = UDim2.new(0, 260, 0, 140)
            
            local layout = Instance.new("UIListLayout")
            layout.Parent = NotifHolder
            layout.SortOrder = Enum.SortOrder.LayoutOrder
            layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
            layout.Padding = UDim.new(0, 8)
        end
        
        local NotifBox = Instance.new("Frame")
        NotifBox.Parent = NotifHolder
        NotifBox.BackgroundColor3 = Color3.fromRGB(20, 12, 32)
        NotifBox.Size = UDim2.new(1, 0, 0, 60)
        NotifBox.BackgroundTransparency = 1
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = NotifBox
        
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(160, 60, 240)
        stroke.Thickness = 1.5
        stroke.Transparency = 1
        stroke.Parent = NotifBox
        
        local titleLbl = Instance.new("TextLabel")
        titleLbl.Parent = NotifBox
        titleLbl.BackgroundTransparency = 1
        titleLbl.Position = UDim2.new(0, 12, 0, 8)
        titleLbl.Size = UDim2.new(1, -24, 0, 20)
        titleLbl.Font = Enum.Font.Code
        titleLbl.Text = title
        titleLbl.TextColor3 = Color3.fromRGB(240, 180, 255)
        titleLbl.TextSize = 14
        titleLbl.TextTransparency = 1
        titleLbl.TextXAlignment = Enum.TextXAlignment.Left
        
        local textLbl = Instance.new("TextLabel")
        textLbl.Parent = NotifBox
        textLbl.BackgroundTransparency = 1
        textLbl.Position = UDim2.new(0, 12, 0, 28)
        textLbl.Size = UDim2.new(1, -24, 0, 24)
        textLbl.Font = Enum.Font.Code
        textLbl.Text = text
        textLbl.TextColor3 = Color3.fromRGB(180, 150, 210)
        textLbl.TextSize = 12
        textLbl.TextTransparency = 1
        textLbl.TextXAlignment = Enum.TextXAlignment.Left
        
        local tweenService = game:GetService("TweenService")
        local info = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        
        tweenService:Create(NotifBox, info, {BackgroundTransparency = 0}):Play()
        tweenService:Create(stroke, info, {Transparency = 0.2}):Play()
        tweenService:Create(titleLbl, info, {TextTransparency = 0}):Play()
        tweenService:Create(textLbl, info, {TextTransparency = 0}):Play()
        
        task.wait(3.5)
        
        tweenService:Create(NotifBox, info, {BackgroundTransparency = 1}):Play()
        tweenService:Create(stroke, info, {Transparency = 1}):Play()
        tweenService:Create(titleLbl, info, {TextTransparency = 1}):Play()
        tweenService:Create(textLbl, info, {TextTransparency = 1}):Play()
        
        task.wait(0.4)
        NotifBox:Destroy()
    end)
end

