        if n:find("ransom") or n:find("a-90") or n:find("jumpscare") then
            if obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("ScreenGui") or obj:IsA("Frame") or obj:IsA("ImageLabel") then
