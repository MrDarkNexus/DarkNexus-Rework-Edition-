-- SEKMELER (CONTAINER)
local Container = Instance.new("Folder")
Container.Name = "TabContainers"
Container.Parent = MainFrame

local TabFrames = {}
local TabButtons = {}

local function CreateTab(name, icon)
    -- Buton
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0, 135, 0, 35)
    Btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    Btn.BackgroundTransparency = 0.5
    Btn.Text = "  " .. icon .. "  " .. name
    Btn.TextColor3 = Color3.fromRGB(180, 180, 200)
    Btn.TextSize = 12
    Btn.Font = Enum.Font.GothamBold
    Btn.TextXAlignment = Enum.TextXAlignment.Left
    Btn.Parent = Sidebar

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = Btn

    -- Sayfa
    local Page = Instance.new("ScrollingFrame")
    Page.Name = name .. "Page"
    Page.Size = UDim2.new(1, -160, 1, -60)
    Page.Position = UDim2.new(0, 155, 0, 55)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 3
    Page.CanvasSize = UDim2.new(0, 0, 0, 500)
    Page.Visible = false
    Page.Parent = MainFrame

    local PageLayout = Instance.new("UIListLayout")
    PageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    PageLayout.Padding = UDim.new(0, 8)
    PageLayout.Parent = Page

    TabFrames[name] = Page
    TabButtons[name] = Btn

    Btn.MouseButton1Click:Connect(function()
        for tName, p in pairs(TabFrames) do
            p.Visible = false
            TabButtons[tName].BackgroundColor3 = Color3.fromRGB(25, 25, 35)
            TabButtons[tName].TextColor3 = Color3.fromRGB(180, 180, 200)
        end
        Page.Visible = true
        Btn.BackgroundColor3 = Color3.fromRGB(0, 229, 255)
        Btn.TextColor3 = Color3.fromRGB(12, 12, 16)
    end)

    return Page
end

