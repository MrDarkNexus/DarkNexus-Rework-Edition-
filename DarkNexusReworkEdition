_G.AntiJamming = _G.AntiJamming or false
local function purgeSound(snd)
    if not _G.AntiJamming then return end
    if not snd or not snd.Parent or not snd:IsA("Sound") then return end
    local sName = string.lower(snd.Name)
    local sId = string.lower(tostring(snd.SoundId))
    if sName:find("jeff") or sName:find("shop") or sName:find("jamming") or sId:find("jeff") or sId:find("shop") then
        pcall(function() snd.Volume = 0; snd:Stop(); snd:Destroy() end)
    end
end
task.spawn(function()
    while true do
        task.wait(0.2)
        if _G.AntiJamming then
            pcall(function()
                for _, snd in ipairs(SoundService:GetDescendants()) do purgeSound(snd) end
                local cr = Workspace:FindFirstChild("CurrentRooms")
                if cr then for _, snd in ipairs(cr:GetDescendants()) do purgeSound(snd) end end
            end)
        end
    end
end)
SoundService.DescendantAdded:Connect(purgeSound)
CreateToggleHelper(HotelFloor, "Anti-Jamming (Jamming / Jeff Shop Sesini Kaldırır)", function(state) _G.AntiJamming = state end)

