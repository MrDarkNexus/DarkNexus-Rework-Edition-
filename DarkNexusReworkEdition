                                            if not obj:FindFirstChild("DarkNessCartHighlight") then
                                                local h = Instance.new("Highlight")
                                                h.Name = "DarkNessCartHighlight"
                                                h.Adornee = obj
                                                h.FillColor = Color3.fromRGB(170, 0, 255)
                                                h.FillTransparency = 0.3
                                                h.OutlineTransparency = 0
                                                h.Parent = obj
                                            end
                                            task.delay(1, function()
                                                if obj and obj.Parent then obj:SetAttribute("DarkNessCartSolving", nil) end
                                            end)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

