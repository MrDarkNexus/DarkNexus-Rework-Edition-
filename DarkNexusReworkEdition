local function bypassFigure(obj)
    if not _G.FigureGodMode or not obj or not obj.Parent then return end
    pcall(function()
        if string.lower(obj.Name):find("figure") then
            if obj:IsA("Model") or obj:IsA("BasePart") then
                for _, part in ipairs(obj:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanTouch = false
                    elseif part:IsA("Script") or part:IsA("LocalScript") then part.Disabled = true end
                end
                if obj:IsA("BasePart") then obj.CanTouch = false end
            end
        end
    end)
end
