local function ApplyTheme(bgCol, strokeCol, sidebarCol, topbarCol, cardBgCol, textCol, logoText, activeTabBgCol, normalTextCol, activeTextCol)
    MainFrame.BackgroundColor3 = bgCol
    MainStroke.Color = strokeCol
    LeftSidebar.BackgroundColor3 = sidebarCol
    TopBar.BackgroundColor3 = bgCol
    SearchBox.BackgroundColor3 = topbarCol
    LogoTitle.Text = logoText
    LogoTitle.TextColor3 = textCol

    WelcomeCard.BackgroundColor3 = cardBgCol
    wcStroke.Color = strokeCol
    ConfigThemeCard.BackgroundColor3 = cardBgCol
    cfgStroke.Color = strokeCol
    
    local aiCard = addonsPage:FindFirstChild("AICard")
    if aiCard then
        aiCard.BackgroundColor3 = cardBgCol
        local st = aiCard:FindFirstChildOfClass("UIStroke")
        if st then st.Color = strokeCol end
    end

    for _, child in ipairs(ButtonContainer:GetChildren()) do
        if child:IsA("TextButton") then
            local lbl = child:FindFirstChildOfClass("TextLabel")
            if child.BackgroundTransparency == 0 then
                child.BackgroundColor3 = activeTabBgCol
                if lbl then lbl.TextColor3 = activeTextCol end
            else
                if lbl then lbl.TextColor3 = normalTextCol end
            end
        end
    end
end

