local function CreateToggleHelper(parent, text, callback)
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(0, 580, 0, 38)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    ToggleBtn.Text = "  [OFF] " .. text
    ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 220)
    ToggleBtn.TextSize = 12
    ToggleBtn.Font = Enum.Font.GothamBold
    ToggleBtn.TextXAlignment = Enum.TextXAlignment.Left
    ToggleBtn.Parent = parent

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = ToggleBtn

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(0, 229, 255)
    Stroke.Transparency = 0.7
    Stroke.Thickness = 1
    Stroke.Parent = ToggleBtn

    local enabled = false
    ToggleBtn.MouseButton1Click:Connect(function()
        enabled = not enabled
        if enabled then
            ToggleBtn.Text = "  [ON] " .. text
            ToggleBtn.TextColor3 = Color3.fromRGB(0, 229, 255)
            Stroke.Transparency = 0
        else
            ToggleBtn.Text = "  [OFF] " .. text
            ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 220)
            Stroke.Transparency = 0.7
        end
        pcall(function() callback(enabled) end)
    end)
end

